# A conflict the running copy raises — the destination appeared after the
# copy checked it, while it scans a large folder — answered Rename asks for
# the name: Esc on that prompt asks about the conflict again (the copy still
# waits), and a name typed there is where the folder lands, the file in the
# way kept.
project empty
config file-manager-taken-names.toml
# The copy is asked only when the destination appears between the check
# before it starts and the copy's own, after its scan: 60000 folders make
# that scan last about two seconds here (as many files, a tenth of it).
# They are made outside the project and moved in whole: made in place,
# their events overflow the watcher's queue, which arrives late as a
# rescan, and the panel reloads under the keys that follow.
setup "mkdir dst ../stage ../stage/big && echo new > ../stage/big/marker && (cd ../stage/big && seq 1 60000 | xargs mkdir) && mv ../stage/big big"
start
wait "big"

# Copy big into dst; while the copy scans, put a file named big in its way.
key Home Down
key F5
wait "Copy"
key Ctrl+A
type "dst"
key Enter
wait "Scanning" 20
run "echo old > dst/big"
wait "Directory Conflict" 60
# Six answers: the copy's own dialog, with items left inside the folder.
expect "Rename All"
snapshot conflict

# Rename, then Esc on the name: back to the conflict, not left waiting.
key Right Right Enter
wait "Rename big"
key Esc
wait "Directory Conflict"
expect-not "Rename big"

# Rename with a name: the folder lands under it.
key Right Right Enter
wait "Rename big"
key Ctrl+A
type "$0_new"
key Enter
wait-gone "Directory Conflict"
file-contains dst/big_new/marker "new" 120
run "grep -qx old dst/big"
expect-not "Conflict"
wait-gone "Scanning" 120
quit --force
