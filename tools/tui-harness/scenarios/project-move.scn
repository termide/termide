# Moving and copying a project (doc/en/projects.md): F6 on its row in the
# Projects menu moves its directory and reopens it at the new path with its
# layout; F5 copies it, and the copy opens in the background beside it.
size 160x36
project empty
start
run "echo hi > keep.txt"
wait "keep.txt"
# The current project's button starts with the ≡ of its menu.
wait-re "^.*Options  ≡ project"

# Move: the prompt names the project's path; typing extends its name.
key F9 Right Right
wait "Change root"
key Up F6
wait "Move 'project' to"
snapshot move-prompt
type "moved"
key Enter
wait "≡ projectmoved"
wait "keep.txt"
# The project directory is gone: `run` works in the one that held it.
run "test -f projectmoved/keep.txt && test ! -e project"
snapshot moved

# Copy: the original stays current, the copy gets a button of its own.
key F9 Right Right
wait "Change root"
key Up F5
wait "Copy 'projectmoved' to"
type "2"
key Enter
wait "≡ projectmoved | projectmoved2"
run "test -f projectmoved2/keep.txt && test -f projectmoved/keep.txt"
snapshot copied
quit
