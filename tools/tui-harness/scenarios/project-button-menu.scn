# A project's button in the menu bar opens its menu, as a menu title does
# (doc/en/ui.md): walking onto it with the arrows opens it; another
# project's offers switching to it, the current one's does not.
size 160x36
project empty
start
wait-re "^.*Projects  project "

# A copy opens in the background beside the current project.
key F9 Right Right Right Right Right
wait "New project"
key Up F5
wait "Copy 'project' to"
type "2"
key Enter
wait "project | project2"

# Six titles, then the current project's button: its menu opens. Right
# walks on, the menus opening with no item chosen.
key F9 Right Right Right Right Right Right
wait "Copy project…"
expect "Close"
expect-not "Switch to project"
snapshot current-menu
# No item is chosen yet: Enter does nothing.
key Enter
sleep 0.3
expect "Copy project…"
expect-not "Move 'project' to"

# The next button is another project's.
key Right
wait "Switch to project"
snapshot other-menu

# Alt+PgUp moves the button, and its menu goes along.
key Alt+PgUp
wait "project2 | project"
expect "Switch to project"

# Enter on Switch to project: project2 becomes the current one, and its
# menu, now first, offers no switching. The menu opened with no item
# chosen: Down chooses the first.
key Down Enter
wait-gone "Switch to project"
key F9 Right Right Right Right Right Right
wait "Copy project…"
expect-not "Switch to project"
key Right
wait "Switch to project"

# F8 asks before closing that project; No brings its menu back.
key F8
wait "Close the project?"
key n
wait "Switch to project"
# Yes closes it, and the menu with it: it does not open again on the
# button left in its place.
key F8
wait "Close the project?"
key y
wait-gone "project2 | project"
sleep 0.3
expect-not "Copy project…"
expect-not "Close the project?"
snapshot closed
quit
