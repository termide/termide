# A project's button in the menu bar opens its menu, as a menu title does
# (doc/en/ui.md): walking onto it with the arrows opens it; the current
# project's offers its root path, another's switching to it.
size 160x36
project empty
start
wait-re "^.*Options  project "

# A copy opens in the background beside the current project.
key F9 Right Right
wait "New project"
# The root path is changed from the project's own menu only.
expect-not "Change root path"
key Up F5
wait "Copy 'project' to"
type "2"
key Enter
wait "project | project2"

# Six titles, then the current project's button: its menu opens. Right
# walks on, the menus opening with no item chosen.
key F9 Right Right Right Right Right Right
wait "Copy project…"
expect "Change root path"
expect-not "Switch to project"
snapshot current-menu
# No item is chosen yet: Enter does nothing.
key Enter
sleep 0.3
expect "Copy project…"
expect-not "Move 'project' to"

# The next button is another project's.
key Right
wait "Switch to project"
expect-not "Change root path"
snapshot other-menu

# Alt+PgUp moves the button, and its menu goes along.
key Alt+PgUp
wait "project2 | project"
expect "Switch to project"

# Enter on Switch to project: project2 becomes the current one, and its
# menu, now first, offers its root path. The menu opened with no item
# chosen: Down chooses the first.
key Down Enter
wait-gone "Switch to project"
key F9 Right Right Right Right Right Right
wait "Copy project…"
expect "Change root path"
key Right
wait "Switch to project"
key Esc
wait-gone "Switch to project"
quit
