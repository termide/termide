# A message to another agent asks every time: its card shows whom it goes
# to and all it says, and offers no answer for the session, since what a
# message asks for is in its text, which no rule reads.
mock-llm
start
wait "README.md"
key Alt+A
wait "Agent"
key Alt+Home Alt+F11
type "message the other panel"
key Enter
wait "Agent wants to run send_message" 20
expect "info 1a2b3c4d: The reorder report is done."
expect-not "Allow for this session"
snapshot permission
type "2"
wait "The message is dealt with." 30
wait-gone "[■]" 15
quit
