#!/bin/sh
# `npx` for the recordings: Claude Code's and Codex's ACP adapters and Gemini
# CLI are the stand-ins beside this file; anything else npx would fetch is not there, as
# offline.
for arg in "$@"; do
    case "$arg" in
        --version) version=1 ;;
        @agentclientprotocol/claude-agent-acp*) adapter=claude-agent-acp ;;
        @agentclientprotocol/codex-acp*) adapter=codex-acp ;;
        @google/gemini-cli*) adapter=gemini-cli ;;
    esac
done
if [ -n "$adapter" ]; then
    [ -n "$version" ] && { echo 0.0.0-demo; exit 0; }
    exec python3 "/opt/shots/mock-acp/$adapter.py"
fi
echo "npx: offline in the recordings: $*" >&2
exit 1
