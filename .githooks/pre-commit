#!/usr/bin/env bash
#
# Repository-wide pre-commit gate: the fmt / machete / clippy / test sequence
# that .github/workflows/ci.yml runs on every pull request, so a commit that
# would fail CI fails here first.
#
# Versioned in the repository and activated with:
#
#     git config core.hooksPath .githooks
#
# (.git/hooks is not part of a clone, so a hook that lives only there is
# absent for every fresh checkout and every new machine.)
#
# This is a final safety net, not a substitute for the narrow per-crate
# checks described in AGENTS.md — prefer `cargo test -p <crate>` while you
# work. Skip it deliberately with `git commit --no-verify`.

set -euo pipefail

# Git invokes hooks with a minimal environment, and GUI clients start from a
# login shell that never sourced ~/.cargo/env. Put a rustup install back on
# PATH before deciding the toolchain is missing.
if ! command -v cargo >/dev/null 2>&1; then
    export PATH="${CARGO_HOME:-$HOME/.cargo}/bin:$PATH"
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "pre-commit: cargo not found on PATH." >&2
    echo "  Install the toolchain (rustup, or 'nix develop' for the Nix shell)" >&2
    echo "  or bypass this hook with 'git commit --no-verify'." >&2
    exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ---------------------------------------------------------------------------
# Docs-only commits
#
# A commit that touches only documentation compiles nothing: no test reads
# doc/ or the top-level Markdown files. Formatting is all there is to check,
# and that is Rust's, so nothing runs. Markdown elsewhere (crates/*/assets,
# skills' scripts) can be compiled in or read by tests and goes through the
# full gate.
# ---------------------------------------------------------------------------

is_doc() {
    case "$1" in
        doc/* | changelog.d/*.md | .agents/skills/*.md) return 0 ;;
        */*) return 1 ;;      # Markdown anywhere else may be compiled in
        *.md) return 0 ;;     # README.md, CHANGELOG.md, AGENTS.md, …
        *) return 1 ;;
    esac
}

docs_only=1
staged_paths=0
while IFS= read -r -d '' path; do
    staged_paths=$((staged_paths + 1))
    is_doc "$path" || docs_only=0
done < <(git diff --cached --name-only -z)
if [ "$staged_paths" -gt 0 ] && [ "$docs_only" -eq 1 ]; then
    printf 'pre-commit: documentation only (%d files) — no build or tests needed.\n' "$staged_paths"
    exit 0
fi

# ---------------------------------------------------------------------------
# What gets checked
#
# A hook that tests the working tree answers the wrong question during a
# partial commit: splitting one edit session into several coherent commits
# leaves the tree ahead of the index, so the gate would pass or fail on code
# that is not what is being recorded. When the index and the working tree
# agree — every change staged and committed — check in place and reuse
# the warm target directory. When they differ, materialise the staged tree in
# a separate worktree under target/ and check that instead.
# ---------------------------------------------------------------------------

# Snapshot what is about to be committed while git's hook environment is still
# intact: GIT_INDEX_FILE may point at a temporary index (`git commit --only`),
# and that is the index whose tree must be tested.
if git diff --quiet; then
    STAGED_TREE=""
else
    STAGED_TREE="$(git write-tree)"
fi

# Every git invocation below runs outside the directory git handed us, so the
# inherited GIT_DIR / GIT_INDEX_FILE / GIT_WORK_TREE — relative paths, all of
# them — would resolve against the wrong root. In a linked worktree `.git` is a
# file, which is what "index file open failed: Not a directory" means.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX

if [ -z "$STAGED_TREE" ]; then
    CHECK_DIR="$REPO_ROOT"
    SCOPE="working tree (identical to the index)"
else
    # A dedicated worktree path and target directory so the staged-tree build
    # cache survives between partial commits instead of thrashing the main one.
    #
    # The worktree is kept and moved to each staged commit rather than created
    # afresh: cargo tells a changed workspace crate by its sources' mtimes, so
    # a new checkout — every file written anew — rebuilt all of them each time.
    # A checkout in place rewrites only the files that differ.
    WORKTREE="$REPO_ROOT/target/pre-commit-worktree"
    staged_commit="$(git -C "$REPO_ROOT" commit-tree "$STAGED_TREE" -p HEAD \
        -m 'pre-commit: staged tree under test')"
    # A `cargo clean` deletes the directory but leaves git's record of it.
    git -C "$REPO_ROOT" worktree prune
    if git -C "$WORKTREE" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$WORKTREE" checkout -q --detach --force "$staged_commit"
        git -C "$WORKTREE" clean -q -d --force
    else
        git -C "$REPO_ROOT" worktree add -q --detach "$WORKTREE" "$staged_commit"
        printf 'pre-commit: partial commit — first run in %s builds from scratch.\n' \
            "$(basename "$WORKTREE")"
    fi
    CHECK_DIR="$WORKTREE"
    SCOPE="staged tree only (working tree has unstaged changes)"
    export CARGO_TARGET_DIR="$REPO_ROOT/target/pre-commit-target"
    # This build is only for the gate, so it carries no debug info: nothing
    # steps through it, and the artefacts are the bulk of a target directory's
    # size. Correctness, warnings and test results are unaffected; only a panic
    # backtrace here would lose line numbers.
    export CARGO_PROFILE_DEV_DEBUG=none
    export CARGO_PROFILE_TEST_DEBUG=none
fi

# A target directory grows with every toolchain and dependency bump until
# builds slow down for it; say so, once a day, rather than let it creep.
SIZE_STAMP="$REPO_ROOT/target/.pre-commit-size-checked"
if [ -d "$REPO_ROOT/target" ] && [ -z "$(find "$SIZE_STAMP" -mtime -1 2>/dev/null)" ]; then
    touch "$SIZE_STAMP"
    target_gib=$(du -sk "$REPO_ROOT/target" | awk '{ print int($1 / 1048576) }')
    if [ "$target_gib" -ge 40 ]; then
        printf 'pre-commit: target/ holds %d GiB; `cargo clean` (or `cargo sweep --time 14`) frees it.\n' \
            "$target_gib"
    fi
fi

printf 'pre-commit: checking %s\n' "$SCOPE"
cd "$CHECK_DIR"

run_step() {
    local label="$1"
    shift
    printf '\n==> %s\n' "$label"
    if ! "$@"; then
        printf '\npre-commit: %s failed — commit aborted.\n' "$label" >&2
        exit 1
    fi
}

run_step "cargo fmt --all -- --check" cargo fmt --all -- --check

# Manifest hygiene: a textual scan, no build, so it runs before the slow steps.
# Unused declarations are invisible to `cargo check`, which is how 99 of them
# accumulated across the workspace before anything looked.
if cargo machete --version >/dev/null 2>&1; then
    run_step "cargo machete" cargo machete
else
    printf '\npre-commit: cargo-machete not installed, skipping manifest check.\n'
    printf '  Install with: cargo install cargo-machete\n'
fi

# No separate `cargo check`: clippy runs the full compiler checks itself, so a
# check pass first would only analyse every crate twice.
run_step "cargo clippy --workspace --all-targets -- -D warnings" \
    cargo clippy --workspace --all-targets -- -D warnings

# nextest runs the suite in parallel processes — about 5x faster here than
# `cargo test` — but must not be a hard requirement for a fresh clone.
if cargo nextest --version >/dev/null 2>&1; then
    run_step "cargo nextest run --workspace" cargo nextest run --workspace
else
    printf '\npre-commit: cargo-nextest not installed, falling back to cargo test.\n'
    printf '  Install with: cargo install cargo-nextest\n'
    run_step "cargo test --workspace" cargo test --workspace
fi

printf '\npre-commit: all checks passed.\n'
