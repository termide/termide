#compdef termide
# Zsh completion for termide.
#
# Install by writing it into a directory on $fpath, then running compinit:
#   termide --completions zsh > ~/.zfunc/_termide
#   fpath=(~/.zfunc $fpath); autoload -Uz compinit; compinit   # in ~/.zshrc
# or system-wide: termide --completions zsh > /usr/share/zsh/site-functions/_termide
#
# Option names are spelled out by hand; src/main.rs has a test that fails
# when a clap option is missing here.

# Detached instances as `id:project` pairs from the `--list-instances` table,
# header dropped. Falls back to files when nothing is running, because
# `--attach` takes an optional id and the next word may be a file to open.
_termide_instances() {
  local -a instances
  instances=(${(f)"$(termide --list-instances 2>/dev/null |
    awk 'NR > 1 { gsub(/:/, "\\:", $5); print $1 ":" $5 }')"})
  if (( ${#instances} )); then
    _describe -t instances 'detached instance' instances
  else
    _files
  fi
}

_arguments \
  '--log-level[Minimum log level]:level:(trace debug info warn error)' \
  '--no-lsp[Disable LSP support]' \
  '--config[Path to config file]:path:_files' \
  '--diagnostics[Run pre-flight diagnostics and exit]' \
  '--detached[Start a detached instance and print its id]' \
  '--attach[Attach to a detached instance, the most recent without an id]::instance:_termide_instances' \
  '(-f --force)'{-f,--force}'[With --attach, take the instance over from the attached client]' \
  '--kill[End a detached instance and exit]:instance:_termide_instances' \
  '--list-instances[List detached instances and exit]' \
  '--completions[Print a shell completion script and exit]:shell:(bash zsh fish)' \
  '--install-completions[Install the completion script for a shell, $SHELL by default]::shell:(bash zsh fish)' \
  '--prompt[Run one agent task without the UI and print the answer]:prompt:' \
  '--recall[Search earlier agent sessions, git history and code and print the results]:query:' \
  '--agent[Agent definition the --prompt run uses]:name:' \
  '--output[Headless output format]:format:(text json stream-json)' \
  '(- *)'{-h,--help}'[Print help]' \
  '(- *)'{-V,--version}'[Print version]' \
  '*:file:_files'
